{
  "name": "ecommerce-chas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Maqueta de e-commerce personalizable: catálogo, carrito, pedidos y panel admin sobre React + Supabase.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "nueva-tienda": "node scripts/nueva-tienda.mjs",
    "emails": "node scripts/generar-emails.mjs",
    "sql:instalacion": "node scripts/armar-instalacion.mjs",
    "verificar": "node scripts/verificar-nucleo.mjs",
    "db:instalar": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/instalar.sql",
    "db:seed": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/seed.sql",
    "db:push": "supabase db push",
    "fn:deploy": "supabase functions deploy enviar-recibo-pedido && supabase functions deploy crear-preferencia-mp && supabase functions deploy webhook-mercadopago --no-verify-jwt",
    "fn:test": "deno test supabase/functions/_shared/"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.45.4",
    "embla-carousel-react": "^8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
