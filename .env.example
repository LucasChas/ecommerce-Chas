# Copiá este archivo como .env y completá con los valores de TU proyecto Supabase
# (Project Settings -> API). La marca y el precio de la plataforma están en
# plataforma/plataforma.config.mjs; la estética base de las tiendas, en
# tienda/tienda.config.mjs.

# URL de la API del proyecto (ID del proyecto + .supabase.co)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" (es segura para el frontend: la seguridad la da RLS)
VITE_SUPABASE_ANON_KEY=

# Opcional: deploy dedicado a UNA tienda con dominio propio (ej. la de un
# cliente en www.sutienda.com). Con esto la tienda se sirve en la raíz del
# dominio en vez de en /t/<slug>. Vacío = la plataforma completa.
VITE_TIENDA_SLUG=
