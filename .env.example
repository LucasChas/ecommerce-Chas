# Copiá este archivo como .env y completá con los valores de TU proyecto Supabase
# (Project Settings -> API). Todo lo demás de la tienda (nombre, WhatsApp,
# colores, moneda...) se configura en tienda/tienda.config.mjs, no acá.

# URL de la API del proyecto (ID del proyecto + .supabase.co)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" (es segura para el frontend: la seguridad la da RLS)
VITE_SUPABASE_ANON_KEY=

# Qué vista expone el deploy (para tener dos URLs desde el mismo repo):
#   - catalog -> tienda pública (la ruta /admin no existe en este deploy)
#   - admin   -> panel privado, servido en la raíz "/"
# En desarrollo local dejala vacía: tenés / (tienda) y /admin (panel).
VITE_APP_MODE=
